{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      ".toolchain/node_modules/@types",
      "src/types"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "lib",
    "node_modules",
    ".toolchain",
    ".research"
  ]
}