{
  "name": "dsh-knowhub",
  "version": "0.8.5",
  "description": "知枢 KnowHub — DSH 全局知识中心与项目长期记忆：知识库、Repo Wiki、审核与版本、增量更新、检索与上下文注入、自动提炼、备份恢复、中文面板",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./host": {
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.6.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node .toolchain/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node tests/smoke.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "wiki",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mw-HbCK/dsh-knowhub.git"
  },
  "homepage": "https://github.com/Mw-HbCK/dsh-knowhub#readme",
  "bugs": {
    "url": "https://github.com/Mw-HbCK/dsh-knowhub/issues"
  }
}
